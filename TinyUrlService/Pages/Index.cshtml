@page
@model IndexModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>

<div class="url-shortener">
    <h1>URL Shortener</h1>

    <form method="post" asp-page="Index" class="url-form">
        <input asp-for="LongUrl" class="url-input" placeholder="Paste your long link here..." />

        <button type="submit" class="shorten-button">
            Shorten
        </button>
    </form>

    @if (!string.IsNullOrEmpty(Model.ShortUrl))
    {
        <div class="result">
            <span class="result-label">Your short URL</span>

            <a href="@Model.ShortUrl" class="short-url">
                @Model.ShortUrl
            </a>
        </div>
    }
</div>